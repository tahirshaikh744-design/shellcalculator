<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/backgroundColor">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/backgroundColor">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvMainLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMI"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvDurationDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 years and 0 month"
                        android:textSize="16sp"
                        android:textColor="#70757A"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvMainValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1.06"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:textColor="#7F00FF"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="48sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginVertical="32dp"
                        android:backgroundTint="#F0F0F0"/>

                    <TextView
                        android:id="@+id/tvSecondaryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total payment"
                        android:textSize="16sp"
                        android:textColor="#70757A" />

                    <TextView
                        android:id="@+id/tvSecondaryValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="127.28"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="28sp" />

                    <!-- Custom Progress Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:orientation="horizontal"
                        android:layout_marginTop="32dp"
                        android:weightSum="100">
                        <View
                            android:id="@+id/viewPrincipal"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="70"
                            android:background="#00C09A" />
                        <View
                            android:id="@+id/viewInterest"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="30"
                            android:background="#7F00FF"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="#00C09A"
                                    android:layout_marginEnd="8dp"/>
                                <TextView
                                    android:id="@+id/tvBottomLabel1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total\nprincipal"
                                    android:textSize="14sp"
                                    android:textColor="#70757A" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvBottomValue1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="100"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                android:layout_marginTop="8dp"
                                android:gravity="start"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="22sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="end">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_gravity="end">
                                <TextView
                                    android:id="@+id/tvBottomLabel2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total interest"
                                    android:textSize="14sp"
                                    android:textColor="#70757A" />
                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="#7F00FF"
                                    android:layout_marginStart="8dp"/>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/tvBottomValue2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="27.28"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"
                                android:layout_marginTop="8dp"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="10sp"
                                app:autoSizeMaxTextSize="22sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/btnStats"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Stats"
            android:textSize="18sp"
            android:textColor="#70757A"
            android:background="?attr/backgroundColor"
            style="@style/Widget.Material3.Button.TextButton" />
        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:text="Share"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7F00FF"
            style="@style/Widget.Material3.Button"
            app:shapeAppearanceOverlay="@null" />
    </LinearLayout>
</LinearLayout>
