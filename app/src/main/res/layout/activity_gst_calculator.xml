<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/backgroundColor">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="?attr/colorOnSurface"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="GST"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_vertical">

            <!-- Original Price -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original price"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tvOriginalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="100"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#7F00FF"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"/>
            </RelativeLayout>

            <!-- GST Rate Selectors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGst3"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="3%"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGst5"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="5%"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGst12"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="12%"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGst18"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="18%"
                    android:layout_marginEnd="4dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGst28"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="28%"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textSize="14sp"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Final Price -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Final price"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/tvFinalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="103"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </RelativeLayout>

            <!-- GST Breakdown -->
            <TextView
                android:id="@+id/tvGstBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CGST/SGST: 1.5"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#70757A"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginHorizontal="24dp" />

    <!-- Keypad -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:padding="16dp">

        <Button android:id="@+id/btn7" style="@style/KeypadBtn" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/KeypadBtn" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/KeypadBtn" android:text="9" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            style="@style/KeypadBtnAction"
            android:text="AC"
            android:layout_rowSpan="2"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            android:textColor="#7F00FF" />

        <Button android:id="@+id/btn4" style="@style/KeypadBtn" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/KeypadBtn" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/KeypadBtn" android:text="6" />

        <Button android:id="@+id/btn1" style="@style/KeypadBtn" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/KeypadBtn" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/KeypadBtn" android:text="3" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/KeypadBtnAction"
            app:icon="@android:drawable/ic_input_delete"
            app:iconGravity="textStart"
            android:layout_rowSpan="2"
            android:layout_height="0dp"
            android:layout_gravity="fill"
            app:iconTint="#7F00FF" />

        <Button android:id="@+id/btn0" style="@style/KeypadBtn" android:text="0" android:layout_columnSpan="2" android:layout_width="0dp" android:layout_columnWeight="2"/>
        <Button android:id="@+id/btnDot" style="@style/KeypadBtn" android:text="." />

    </GridLayout>

</LinearLayout>
