<resources>
    <!-- Base Application Theme (Night) -->
    <style name="Theme.CalculatorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="backgroundColor">@color/bg_main</item>
        <item name="btnScientificColor">@color/btn_scientific</item>
        <item name="btnNumberColor">@color/btn_number</item>
        <item name="btnOperatorColor">@color/btn_operator</item>
        <item name="btnEqualColor">@color/btn_equal</item>
        <item name="textPrimaryColor">@color/text_primary</item>
        <item name="textSecondaryColor">@color/text_secondary</item>

        <item name="android:windowBackground">?attr/backgroundColor</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- AMOLED Dark Mode Theme (Night) -->
    <style name="Theme.CalculatorApp.Amoled" parent="Theme.CalculatorApp">
        <item name="backgroundColor">#000000</item>
        <item name="btnScientificColor">#000000</item>
        <item name="btnNumberColor">#000000</item>
        <item name="btnOperatorColor">#1C1C1E</item>
        <item name="textPrimaryColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash Screen Theme (Night) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/violet</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CalculatorApp</item>
    </style>

    <!-- Restoring all styles to Night folder to fix resource linking -->
    <style name="AgeSummaryItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="AgeSummaryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#70757A</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AgeSummaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeypadBtn" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnNumberColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KeypadBtnAction" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnScientificColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="KeypadBtnSmall" parent="BaseBtn">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">?attr/btnNumberColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
    </style>

    <style name="KeypadBtnActionSmall" parent="BaseBtn">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">?attr/btnScientificColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
    </style>
</resources>