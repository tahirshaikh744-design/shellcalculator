<resources>
    <!-- Base Application Theme -->
    <style name="Theme.CalculatorApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="backgroundColor">@color/bg_main</item>
        <item name="btnScientificColor">@color/btn_scientific</item>
        <item name="btnNumberColor">@color/btn_number</item>
        <item name="btnOperatorColor">@color/btn_operator</item>
        <item name="btnEqualColor">@color/btn_equal</item>
        <item name="textPrimaryColor">@color/text_primary</item>
        <item name="textSecondaryColor">@color/text_secondary</item>

        <item name="android:windowBackground">?attr/backgroundColor</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/violet</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CalculatorApp</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="BaseBtn" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">0.5dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1A70757A</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ScientificBtn" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnScientificColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="NumberBtn" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnNumberColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="OperatorBtn" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnOperatorColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="EqualBtn" parent="BaseBtn">
        <item name="android:backgroundTint">@color/btn_equal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">46sp</item>
        <item name="strokeColor">#33FFFFFF</item>
    </style>

    <style name="UnitItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="UnitIconStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="UnitTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="AgeSummaryItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="AgeSummaryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#70757A</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AgeSummaryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="KeypadBtn" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnNumberColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="KeypadBtnAction" parent="BaseBtn">
        <item name="android:backgroundTint">?attr/btnScientificColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="KeypadBtnSmall" parent="BaseBtn">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">?attr/btnNumberColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
    </style>

    <style name="KeypadBtnActionSmall" parent="BaseBtn">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">?attr/btnScientificColor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
    </style>
</resources>
